.modal-overlay.active { opacity: 1; visibility: visible; }

.modal-content {
  background: #1a1a2e; border: 1px solid rgba(99,102,241,0.25);
  border-radius: 16px; padding: 40px 34px; width: 90%; max-width: 540px;
  position: relative; color: #e2e8f0; text-align: center;
  transform: scale(0.9) translateY(15px); transition: transform 0.3s cubic-bezier(0.34,1.56,0.64,1);
}
.modal-overlay.active .modal-content { transform: scale(1) translateY(0); }

.modal-content h3 { margin: 0 0 20px; color: #fff; font-size: 22px; }
.modal-content p { margin: 0 0 17px; font-size: 15px; line-height: 1.5; color: #94a3b8; }

.modal-close {
  position: absolute; top: 14px; right: 14px; background: none; border: none;
  color: #64748b; font-size: 22px; cursor: pointer; padding: 4px; transition: 0.2s;
}
.modal-close:hover { color: #fff; transform: rotate(90deg); }

.btn-acquire {
  display: block;
  width: 100%;
  padding: 22px 24px;
  margin-top: 100px;
  background: linear-gradient(135deg, #4f46e5, #6366f1);
  color: white;
  border: none;
  border-radius: 14px;
  font-size: 18px;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.2s ease;
}
.btn-acquire:hover {
  transform: translateY(-2px);
  box-shadow: 0 6px 20px rgba(79, 70, 229, 0.4);
}

.site-footer {
  background: #0b0b14;
  border-top: 1px solid rgba(255, 255, 255, 0.08);
  padding: 40px 20px 30px;
  margin-top: 60px;
}

.footer-container {
  max-width: 900px;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24px;
}

.footer-socials {
  display: flex;
  gap: 16px;
}

.social-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.05);
  border: 1px solid rgba(255, 255, 255, 0.1);
  color: #94a3b8;
  text-decoration: none;
  transition: all 0.3s;
}

.social-icon:hover {
  background: #4f46e5;
  border-color: #4f46e5;
  color: white;
  transform: translateY(-2px);
}

.footer-nav {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 12px 24px;
}

.footer-nav a {
  color: rgba(255, 255, 255, 0.6);
  text-decoration: none;
  font-size: 14px;
  font-weight: 500;
  transition: color 0.2s;
}

.footer-nav a:hover {
  color: white;
}

.footer-copyright {
  color: rgba(255, 255, 255, 0.3);
  font-size: 13px;
}

/* ========================================
   АДАПТИВНАЯ ВЕРСТКА
   ======================================== */

@media screen and (max-width: 1024px) {
    .his-item, .team-item {
        gap: 40px;
        padding: 60px 40px;
    }
    .his-img, .team-img {
        flex: 0 0 45%;
        height: 400px;
    }
    .his-text h2, .team-text h2 {
        font-size: 2.2rem;
    }
}

@media screen and (max-width: 768px) {
    header {
        padding: 0 20px;
        height: auto;
        min-height: 60px;
        flex-direction: column;
        justify-content: center;
        gap: 10px;
        padding: 10px 0;
    }

    nav {
        gap: 10px;
        flex-wrap: wrap;
        justify-content: center;
    }

    nav a {
        font-size: 12px;
    }

    .hero {
        padding-top: 100px;
    }

    .win {
        position: static;
        margin: 0 20px;
        max-width: 100%;
        text-align: center;
    }

    .win h1 {
        font-size: 1.8rem;
    }

    .me .content {
        padding: 20px;
    }

    .me .content h1 {
        font-size: 1.5rem;
    }

    .me .content p {
        font-size: 0.9rem;
        line-height: 1.6;
    }

    .his-item, .team-item {
        flex-direction: column;
        padding: 40px 20px 80px;
        text-align: center;
    }

    .his-img, .team-img {
        flex: 0 0 100%;
        width: 100%;
        height: 250px;
    }

    .his-text h2, .team-text h2 {
        font-size: 1.8rem;
        margin-top: 20px;
    }

    .his-text p, .team-text p {
        font-size: 1rem;
    }

    .his-btn, .team-btn {
        width: 45px;
        height: 45px;
        font-size: 20px;
        bottom: 20px;
    }

    .prem-content h1, .text-side h1 {
        font-size: 2.5rem;
    }

    .prem-content p, .text-side p {
        font-size: 1.1rem;
    }

    .map-side iframe {
        height: 300px;
    }

    .form-card {
        padding: 30px 20px;
    }

    .form-card h2 {
        font-size: 24px;
    }

    .form-card p.subtitle {
        font-size: 18px;
    }

    .btn-acquire {
        margin-top: 40px;
    }
}

@media screen and (max-width: 480px) {
    .win h1 {
        font-size: 1.5rem;
    }

    .prem-content h1, .text-side h1 {
        font-size: 2rem;
    }

    .footer-nav {
        flex-direction: column;
        align-items: center;
        gap: 10px;
    }
}
